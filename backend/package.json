{
  "name": "@casecoach/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-turn.ts",
    "eval": "RUN_LIVE_EVALS=1 vitest run evals"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.4",
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-polly": "^3.1149.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@casecoach/shared": "*",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
