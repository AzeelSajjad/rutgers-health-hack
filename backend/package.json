{
  "name": "@casecoach/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run && tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/live-demo-check.ts",
    "eval": "RUN_LIVE_EVALS=1 vitest run evals",
    "import:profiles": "tsx scripts/import-sample-profiles.ts",
    "aws:check": "node --import tsx scripts/check-aws.ts",
    "aws:deploy": "node --import tsx scripts/deploy-sessions.ts",
    "import:mimic-demo": "tsx scripts/import-mimic-demo.ts",
    "demo:check": "tsx scripts/demo-check.ts",
    "live:storage": "tsx scripts/live-storage-check.ts",
    "live:voice": "tsx scripts/live-voice-check.ts",
    "live:system": "tsx scripts/live-system-check.ts",
    "configure:auth": "tsx scripts/configure-auth.ts",
    "live:history": "tsx scripts/live-history-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.4",
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-cloudformation": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-polly": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-sts": "^3.1149.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1149.0",
    "@aws-sdk/credential-providers": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@casecoach/shared": "*",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
