# Optional overrides for the public SPA settings in public/auth-config.js.
# VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# VITE_AUTH0_CLIENT_ID=your-public-spa-client-id
# VITE_AUTH0_AUDIENCE=https://casecoach.example/api

# Default: same-origin /ws (Vite proxies to ws://localhost:3001/ws).
# VITE_ENCOUNTER_WS_URL=wss://your-development-host.example/ws
